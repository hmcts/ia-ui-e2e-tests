{
  "name": "tcoe-playwright-example",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.11.1"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.11.1",
    "@faker-js/faker": "^10.1.0",
    "@hmcts/playwright-common": "^1.0.36",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.15.34",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "axios": "^1.7.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "get-port": "^7.1.0",
    "globals": "^16.0.0",
    "lighthouse": "^12.2.1",
    "playwright": "^1.48.2",
    "playwright-core": "^1.48.2",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  },
  "scripts": {
    "lint": "yarn tsc -p tsconfig.json && yarn eslint .",
    "setup": "yarn playwright install --with-deps",
    "setup:edge": "PLAYWRIGHT_BROWSERS_PATH=0 yarn playwright install msedge --with-deps",
    "load-secrets-aat": "yarn get-secrets ia-aat",
    "test:citizen:e2e": "yarn playwright test tests/citizen --project chrome --grep @e2e",
    "test:citizen:functional": "yarn playwright test tests/citizen --project chrome --grep @functional",
    "test:citizen:crossBrowser": "yarn playwright test tests/citizen --project firefox --project webkit --project edge",
    "test:exui:functional": "yarn playwright test tests/exui --project chrome --grep @functional",
    "test:legal-rep:e2e": "yarn playwright test tests/legal-rep --project chrome --grep @e2e"
  },
  "packageManager": "yarn@4.9.4",
  "dependencies": {
    "i18n-iso-countries": "^7.14.0",
    "uuid": "^11.1.0"
  }
}
